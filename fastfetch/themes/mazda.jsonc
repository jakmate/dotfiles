{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/jdm.txt",
        //"height": 1,
        //"width": 1,
        //"padding": {
        //    "top": 0,
        //    "left": 0,
        //    "right": 0
        //},
        "color": {
            "1": "#F01416",   // redline
            "2": "#7D7F82"    // metallic accent
        }
    },

    "display": {
        "separator": " 󰘧 ",
        "color": {
            "separator": "#796563", // warm trim
            "keys": "#7D7F82",      // metallic labels
            "title": "#F01416"      // ignition red
        }
    },

    "modules": [
        {
            "type": "title",
            "keyColor": "#F01416"
        },
        {
            "type": "separator"
        },

        {
            "type": "os",
            "key": "OS",
            "keyColor": "#7D7F82"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "#7D7F82"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "#7D7F82"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "#7D7F82"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#7D7F82"
        },

        {
            "type": "break"
        },

        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#7D7F82"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "#7D7F82"
        },
        {
            "type": "theme",
            "key": "Theme",
            "keyColor": "#7D7F82"
        },
        {
            "type": "icons",
            "key": "Icons",
            "keyColor": "#7D7F82"
        },

        {
            "type": "break"
        },

        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "#7D7F82"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "#7D7F82"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "#7D7F82"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "#7D7F82"
        },
        {
            "type": "battery",
            "key": "Battery",
            "keyColor": "#7D7F82"
        }
    ]
}

