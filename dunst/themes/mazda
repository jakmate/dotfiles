[global]
    ### Geometry & layout (instrument cluster popups)
    width = 360
    height = (0, 90)
    origin = "top-right"
    offset = (20, 52)   # Sits just under Waybar
    scale = 0
    notification_limit = 5
    gap_size = 8

    ### Progress bar (fuel / RPM style)
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 1
    progress_bar_min_width = 160
    progress_bar_max_width = 300

    ### Padding & spacing
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12
    separator_height = 1
    frame_width = 1

    ### Typography
    font = "JetBrains Mono 10"
    line_height = 0
    markup = "yes"
    format = "<b>%s</b>\n%b"
    alignment = "left"
    vertical_alignment = "center"
    ellipsize = "middle"

    ### Behavior
    transparency = 0
    indicate_hidden = true
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = false
    ignore_newline = false

    ### Core JDM palette (matches Waybar/Wofi)
    background = "#201D1F"
    foreground = "#D7D7DA"
    frame_color = "#7D7F82"
    highlight = "#F01416"
    separator_color = "frame"

    ### Icons
    icon_path = "/usr/share/icons/Adwaita/32x32/status:/usr/share/icons/Adwaita/32x32/devices"
    enable_recursive_icon_lookup = true

    ### Shape (hard edges = OEM)
    corner_radius = 0

    ### Browser
    browser = "/usr/bin/xdg-open"

    ### Mouse controls
    mouse_left_click = "do_action"
    mouse_middle_click = "close_all"
    mouse_right_click = "close_current"

